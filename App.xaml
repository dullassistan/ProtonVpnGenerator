<Application x:Class="ProtonVpnGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProtonVpnGenerator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Background Gradients -->
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EBE7FA" Offset="0.0"/>
            <GradientStop Color="#E2DCF7" Offset="0.5"/>
            <GradientStop Color="#D8D2F5" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackground" Color="#F6F4FD"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D3CCF0"/>
        <SolidColorBrush x:Key="CardInnerBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4338CA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- Feature Accent Solid Colors -->
        <SolidColorBrush x:Key="AccentIndigo" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentViolet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentRose" Color="#F43F5E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSlate" Color="#334155"/>

        <!-- ============================================== -->
        <!-- CONVEX (ВЫПУКЛЫЕ) 3D КНОПКИ                    -->
        <!-- ============================================== -->

        <!-- ============================================== -->
        <!-- GLOSSY CONVEX 3D BUTTONS (ГЛЯНЦЕВЫЙ 3D СТИЛЬ)   -->
        <!-- ============================================== -->

        <!-- 3D Shadow/Bevel Depth Brushes -->
        <SolidColorBrush x:Key="ShadowIndigo" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="ShadowEmerald" Color="#064E3B"/>
        <SolidColorBrush x:Key="ShadowViolet" Color="#4C1D95"/>
        <SolidColorBrush x:Key="ShadowBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="ShadowSlate" Color="#0F172A"/>
        <SolidColorBrush x:Key="ShadowAmber" Color="#78350F"/>
        <SolidColorBrush x:Key="ShadowRose" Color="#881337"/>
        <SolidColorBrush x:Key="ShadowTeal" Color="#134E4A"/>

        <!-- Base Template for Glossy Convex 3D Button (ZERO BLUR, 100% CLEARTYPE!) -->
        <ControlTemplate x:Key="ConvexButtonTemplate" TargetType="Button">
            <Grid x:Name="RootGrid" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <!-- 1. Bottom physical 3D bevel base (Solid dark edge, NO BLUR!) -->
                <Border x:Name="BevelBase" 
                        CornerRadius="5" 
                        Background="{TemplateBinding Tag}" 
                        Margin="0,2,0,0"/>
                
                <!-- 2. Main Button Body (Offset up by 2px to expose bottom depth) -->
                <Border x:Name="BodyBorder" 
                        CornerRadius="5" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,0,0,2">
                    <Grid SnapsToDevicePixels="True">
                        <!-- 3. Specular Gloss Reflection (Top Half Highlight) -->
                        <Border x:Name="GlossLayer" 
                                CornerRadius="4,4,1,1" 
                                Height="12" 
                                VerticalAlignment="Top" 
                                Margin="1,1,1,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#90FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#30FFFFFF" Offset="0.6"/>
                                    <GradientStop Color="#05FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 4. Inner Top Edge Highlight Line -->
                        <Border CornerRadius="4" 
                                BorderThickness="1,1,1,0" 
                                BorderBrush="#60FFFFFF" 
                                Margin="1,1,1,1"/>

                        <!-- 5. Razor-Sharp Text/Content Presenter (ClearType active!) -->
                        <ContentPresenter x:Name="ContentSite" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BodyBorder" Property="Opacity" Value="0.95"/>
                    <Setter TargetName="GlossLayer" Property="Opacity" Value="1.3"/>
                    <Setter TargetName="BodyBorder" Property="BorderBrush" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <!-- Physical push down animation: moves down 2px over bevel -->
                    <Setter TargetName="BodyBorder" Property="Margin" Value="0,2,0,0"/>
                    <Setter TargetName="BevelBase" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BodyBorder" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="BevelBase" Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Convex Button Base Style -->
        <Style x:Key="ConvexBtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template" Value="{StaticResource ConvexButtonTemplate}"/>
        </Style>

        <!-- 1. INDIGO GLOSSY (AWG 1.0, Generate) -->
        <Style x:Key="ConvexBtnIndigo" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#818CF8"/>
            <Setter Property="Tag" Value="{StaticResource ShadowIndigo}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6366F1" Offset="0.0"/>
                        <GradientStop Color="#4F46E5" Offset="0.5"/>
                        <GradientStop Color="#3730A3" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. EMERALD GLOSSY (AWG 2.0, Copy) -->
        <Style x:Key="ConvexBtnEmerald" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#6EE7B7"/>
            <Setter Property="Tag" Value="{StaticResource ShadowEmerald}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10B981" Offset="0.0"/>
                        <GradientStop Color="#059669" Offset="0.5"/>
                        <GradientStop Color="#047857" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. VIOLET GLOSSY (AWG 3.0, Zip Countries) -->
        <Style x:Key="ConvexBtnViolet" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#C4B5FD"/>
            <Setter Property="Tag" Value="{StaticResource ShadowViolet}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8B5CF6" Offset="0.0"/>
                        <GradientStop Color="#7C3AED" Offset="0.5"/>
                        <GradientStop Color="#6D28D9" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. BLUE GLOSSY (Domain, Single Download) -->
        <Style x:Key="ConvexBtnBlue" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Tag" Value="{StaticResource ShadowBlue}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B82F6" Offset="0.0"/>
                        <GradientStop Color="#2563EB" Offset="0.5"/>
                        <GradientStop Color="#1D4ED8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. SLATE GLOSSY (Download All) -->
        <Style x:Key="ConvexBtnSlate" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="Tag" Value="{StaticResource ShadowSlate}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#64748B" Offset="0.0"/>
                        <GradientStop Color="#475569" Offset="0.5"/>
                        <GradientStop Color="#334155" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. AMBER GLOSSY (AWG 3.1) -->
        <Style x:Key="ConvexBtnAmber" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#FDE68A"/>
            <Setter Property="Tag" Value="{StaticResource ShadowAmber}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F59E0B" Offset="0.0"/>
                        <GradientStop Color="#D97706" Offset="0.5"/>
                        <GradientStop Color="#B45309" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 7. ROSE/RED GLOSSY (Reset, Danger) -->
        <Style x:Key="ConvexBtnRose" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="Tag" Value="{StaticResource ShadowRose}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F43F5E" Offset="0.0"/>
                        <GradientStop Color="#E11D48" Offset="0.5"/>
                        <GradientStop Color="#BE123C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8. TEAL GLOSSY (WireSock Random) -->
        <Style x:Key="ConvexBtnTeal" TargetType="Button" BasedOn="{StaticResource ConvexBtnBase}">
            <Setter Property="BorderBrush" Value="#99F6E4"/>
            <Setter Property="Tag" Value="{StaticResource ShadowTeal}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2DD4BF" Offset="0.0"/>
                        <GradientStop Color="#14B8A6" Offset="0.5"/>
                        <GradientStop Color="#0D9488" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- COMPACT UNIFORM TOGGLE SWITCH (36x18 px)       -->
        <!-- ============================================== -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Tag" Value="{StaticResource AccentIndigo}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!-- Switch Track: 36x18 px -->
                            <Grid Width="36" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Track" 
                                        CornerRadius="9" 
                                        Background="#CBD5E1" 
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" 
                                         Width="14" Height="14" 
                                         Fill="White" 
                                         Stroke="#94A3B8"
                                         StrokeThickness="0.5"
                                         HorizontalAlignment="Left" 
                                         Margin="2,2,0,2"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"/>
                                <Setter TargetName="Thumb" Property="Stroke" Value="{x:Null}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,2,2,2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- CLIENT SELECTOR RADIO CARDS (GLOSSY CRISP)     -->
        <!-- ============================================== -->
        <Style x:Key="ClientCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Bottom Bevel Edge -->
                            <Border x:Name="Bevel" 
                                    CornerRadius="5" 
                                    Background="#D3CCF0" 
                                    Margin="0,1.5,0,0"/>

                            <Border x:Name="border" 
                                    CornerRadius="5" 
                                    Background="#F6F4FD" 
                                    BorderBrush="#C7BEEA" 
                                    BorderThickness="1" 
                                    Padding="6,2"
                                    Margin="0,0,0,1.5">
                                <Grid>
                                    <!-- Top gloss line -->
                                    <Border x:Name="Gloss" 
                                            CornerRadius="4,4,0,0" 
                                            Height="11" 
                                            VerticalAlignment="Top" 
                                            Margin="1,1,1,0"
                                            Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6366F1" Offset="0.0"/>
                                            <GradientStop Color="#4F46E5" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="Bevel" Property="Background" Value="#1E1B4B"/>
                                <Setter TargetName="Gloss" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#1E1B4B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- PORT PILL RADIO (GLOSSY CRISP)                 -->
        <!-- ============================================== -->
        <Style x:Key="PortPill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="1.5,1.5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bevel" 
                                    CornerRadius="4" 
                                    Background="#D3CCF0" 
                                    Margin="0,1,0,0"/>
                            <Border x:Name="border" 
                                    CornerRadius="4" 
                                    Background="#EDE9FE" 
                                    BorderBrush="#C4B5FD" 
                                    BorderThickness="1" 
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,0,1">
                                <Grid>
                                    <Border x:Name="Gloss" 
                                            CornerRadius="3,3,0,0" 
                                            Height="9" 
                                            VerticalAlignment="Top" 
                                            Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6366F1" Offset="0.0"/>
                                            <GradientStop Color="#4F46E5" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="Bevel" Property="Background" Value="#1E1B4B"/>
                                <Setter TargetName="Gloss" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- COUNTRY FILTER PILL (CRISP & BOLD)             -->
        <!-- ============================================== -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Margin" Value="1,1.5"/>
            <Setter Property="FontSize" Value="9.8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bevel" 
                                    CornerRadius="11" 
                                    Background="#D0C7F0" 
                                    Margin="0,1,0,0"/>
                            <Border x:Name="border" 
                                    CornerRadius="11" 
                                    Background="#EDE9FE" 
                                    BorderBrush="#C4B5FD" 
                                    BorderThickness="1" 
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,0,1">
                                <Grid>
                                    <Border x:Name="Gloss" 
                                            CornerRadius="10,10,0,0" 
                                            Height="9" 
                                            VerticalAlignment="Top" 
                                            Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6366F1" Offset="0.0"/>
                                            <GradientStop Color="#4F46E5" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="Bevel" Property="Background" Value="#1E1B4B"/>
                                <Setter TargetName="Gloss" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#1E1B4B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- COMPACT MODERN TEXTBOX                         -->
        <!-- ============================================== -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" 
                                           Foreground="#4B5563" 
                                           FontSize="10.5" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           Margin="2,0,2,0" 
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ultra-thin sleek ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Foreground" Value="#A5B4FC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="5" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#A5B4FC" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
